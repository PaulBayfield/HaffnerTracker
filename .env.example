# Copy this file to .env and fill in real values.

ENV=dev

# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
TOKEN=

# Your Discord user ID, used to grant owner-only commands
OWNER_ID=

# Optional: NewsAPI.org free API key (https://newsapi.org/register)
# News still works without it via Google News RSS + the press release page.
NEWSAPI_KEY=

# Status endpoint (GET /status), served by dPyStatus: https://github.com/PaulBayfield/dPyStatus
# Use 0.0.0.0 inside Docker so the port is reachable from outside the container.
DPYSTATUS_HOST=127.0.0.1
DPYSTATUS_PORT=8080
# Optional: require "Authorization: Bearer <token>" on requests
DPYSTATUS_TOKEN=
